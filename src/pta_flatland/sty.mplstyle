# Set default figure size
figure.figsize : 13, 12

# Set x axis
xtick.major.size : 15
xtick.major.width : 1
xtick.minor.size : 10
xtick.minor.width : 0.5
xtick.direction : in
xtick.top : True

# Set y axis
ytick.major.size : 15
ytick.major.width : 1
ytick.minor.size : 10
ytick.minor.width : 0.5
ytick.direction : in
ytick.right : True

# Fontsizes
xtick.labelsize : 25
ytick.labelsize : 25
xtick.major.pad : 9
legend.fontsize : 25
legend.title_fontsize : 15
axes.titlesize : 30
axes.labelsize : 25

# Line widths
axes.linewidth : 1
grid.linewidth : 1
lines.linewidth : 2
lines.solid_capstyle : round

# Font style
font.family : serif
text.usetex : True
font.serif: cm

# margins
#axes.xmargin : 0
#axes.ymargin : 0

# Legend
legend.frameon : False

# Set color cycle:
axes.prop_cycle : cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'])
